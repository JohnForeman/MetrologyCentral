---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://metrologycentral.com{{ site.baseurl }}/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  {% for page in site.pages %}
    {% unless page.url contains "." or page.url contains "/working-articles/" or page.url contains "/page" or page.url == "/" or page.sitemap == false or page.name == "404.html" %}
  <url>
    <loc>https://metrologycentral.com{{ site.baseurl }}{{ page.url }}</loc>
    {% if page.last_modified_at %}<lastmod>{{ page.last_modified_at | date_to_xmlschema }}</lastmod>{% endif %}
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
    {% endunless %}
  {% endfor %}
  {% for post in site.posts %}
  <url>
    <loc>https://metrologycentral.com{{ site.baseurl }}{{ post.url }}</loc>
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  {% endfor %}
  {% for c in site.atlas_cases %}
  <url>
    <loc>https://metrologycentral.com{{ site.baseurl }}{{ c.url }}</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  {% endfor %}
</urlset>
